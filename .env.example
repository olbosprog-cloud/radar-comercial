# ==============================================================================
# RADAR COMERCIAL B2B - CONFIGURAÇÕES DE AMBIENTE
# ==============================================================================

# Modo de Operação dos Dados e Enriquecimento:
# MOCK       -> Geração realista offline com Faker pt_BR + CNPJs matematicamente válidos
# FREE       -> Dados reais gratuitos (BrasilAPI + OpenStreetMap Nominatim/Overpass)
# PRODUCTION -> Google Places API oficial com alta precisão cadastral e comercial
DATA_MODE=MOCK

# Servidor Backend
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Google Places API (Obrigatório apenas quando DATA_MODE=PRODUCTION)
GOOGLE_PLACES_API_KEY=

# Caminho do Banco de Dados SQLite Local
SQLITE_DB_PATH=./data/radar_comercial.db

# Template Padrão de Mensagem para Primeiro Contato no WhatsApp
# Tags suportadas: {nome_fantasia}, {razao_social}, {cidade}, {bairro}, {cnae}
DEFAULT_WHATSAPP_TEMPLATE=Olá, {nome_fantasia}! Tudo bem? Sou representante comercial e atendo lojistas aqui na região de {cidade} ({bairro}). Gostaria de apresentar nosso catálogo exclusivo para o seu segmento. Poderíamos conversar 2 minutos?
